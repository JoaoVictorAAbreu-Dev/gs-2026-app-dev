# Copie para .env (o .env real não vai para o Git nem para o .zip).
# O Node 22+ lê o arquivo sozinho (--env-file); não precisa do pacote dotenv.

# Porta do servidor
PORT=3000

# MongoDB local (padrão) ou string do MongoDB Atlas, por exemplo:
# MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# Nome do banco; a coleção se chama "relatos"
MONGODB_DB=territorio_seguro
